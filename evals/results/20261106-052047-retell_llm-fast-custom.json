        {
          "role": "agent",
          "text": "Sorry to hear that. Got it, a furnace that stopped heating. Can I get your name?",
          "said": null
        },
        {
          "role": "caller",
          "text": "Alicia Romero.",
          "said": null
        },
        {
          "role": "agent",
          "text": "Thanks. And this is for your home, right?",
          "said": null
        },
        {
          "role": "caller",
          "text": "Yes, it's my home. I'm at 2214 Avenue U in Brooklyn, 11229.",
          "said": null
