      "transcript": [
        {
          "role": "agent",
          "text": "Hi, this is Summit Air. Is this Dennis?",
          "said": null
        },
        {
          "role": "caller",
          "text": "Hi, I'd like to book my annual boiler tune-up.",
          "said": null
        },
        {
          "role": "agent",
          "text": "Sure, I can set that up. I've got you at 801 Fenimore Street in Brooklyn, is that still the right address?",
          "said": null
        },
        {
          "role": "caller",
          "text": "Yes, that's right. I'm in the downstairs unit, and the bell is the one for the downstairs. Is there any other information you need?",
          "said": null
        },
        {
          "role": "agent",
          "text": "Got it, I'll note the downstairs bell. Let me check what's open for a tune-up. I have openings today from 12 to 4 or 4 to 8, tomorrow morning, afternoon or evening, or Thursday from 12 to 4. Which works best for you?",
          "said": null
        },
        {
          "role": "caller",
          "text": "Sorry, I should have said this earlier, I was looking for a weekday morning next week. Do you have anything on Monday morning?",
          "said": null
        },
        {
          "role": "agent",
          "text": "Let me check next Monday morning. Yes, Monday, November 9 from 8 to 12 is open. Shall I book that?",
          "said": null
        },
        {
          "role": "caller",
          "text": "Yes, Monday the 9th, 8 to 12, that works. Please book it.",
          "said": null
        },
        {
          "role": "agent",
          "text": "I have your home at 801 Fenimore St, unit downstairs, Brooklyn, one one two zero six, and the best number is three four seven, five five five, zero one six two, is that right?",
          "said": null
        },
        {
          "role": "caller",
          "text": "Yes, that's all correct. Thanks.",
          "said": null
        },
        {
          "role": "agent",
          "text": "Should that address go on its own account, with you as a contact, or under your account?",
          "said": null
        },
        {
          "role": "caller",
          "text": "Under my account, please. I'm the owner of the house, so put it under my name, Dennis Ocasio.",
          "said": null
        },
        {
          "role": "agent",
          "text": "Got it. Before I book, what's the system's rough age, and has anything been going wrong with it?",
          "said": null
        },
        {
          "role": "caller",
          "text": "It's a gas boiler, about eight years old. It's been running fine, no problems. I just want the yearly tune-up.",
          "said": null
        },
        {
          "role": "agent",
          "text": "Thanks. Anything the technician should know when they get there, like a gate code, a buzzer or a pet?",
          "said": null
        },
        {
          "role": "caller",
          "text": "No gate code. Just ring the downstairs bell. I'm home during the day since I work from home, so someone should be around. There's no pet to worry about.",
          "said": null
        },
        {
          "role": "agent",
          "text": "Got it, I'll note to ring the downstairs bell. Booking that now. You're all set for Monday, November 9, with the technician arriving between 8 and 12. Anything else?",
          "said": null
        },
        {
          "role": "caller",
          "text": "That's everything, thank you. Have a good day.",
          "said": null
        },
        {
          "role": "agent",
          "text": "Thanks for calling Summit Air. Have a great rest of your day.",
          "said": null
        }
      ],
