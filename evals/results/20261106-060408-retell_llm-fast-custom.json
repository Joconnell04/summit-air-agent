      "transcript": [
        {
          "role": "agent",
          "text": "Hi Dennis, thanks for calling Summit Air! I'm Brian, the virtual assistant. How can I help?",
          "said": null
        },
        {
          "role": "caller",
          "text": "Hi, I'd like to book my annual boiler tune-up.",
          "said": null
        },
        {
          "role": "agent",
          "text": "Perfect. And this is for your home, right?",
          "said": null
        },
        {
          "role": "caller",
          "text": "Yes, it's for my home in Brooklyn.",
          "said": null
        },
        {
          "role": "agent",
          "text": "Got it. Is the address 801 Fenimore Street, same as on file?",
          "said": null
        },
        {
          "role": "caller",
          "text": "Yes, that's right. It's 801 Fenimore Street, Brooklyn, 11206. I'm in the downstairs unit.",
          "said": null
        },
        {
          "role": "agent",
          "text": "Okay, thanks. Perfect. So that's eight oh one Fenimore St, unit D O W N S T A I R S, and the number you're calling from, ending in zero one six two. That's all correct, right?",
          "said": null
        },
        {
          "role": "caller",
          "text": "Almost. The downstairs unit isn't labeled that way, so just note it as the downstairs unit. And yes, the number I'm calling from is the best one to reach me, ending in 0162.",
          "said": null
        },
        {
          "role": "agent",
          "text": "One sec. Should I put this under your account?",
          "said": null
        },
        {
          "role": "caller",
          "text": "Yes, please put it under my account. I'm Dennis Ocasio, and that's the name on the account.",
          "said": null
        },
        {
          "role": "agent",
          "text": "Thanks. When would you like the tune-up? I can check openings for today, tomorrow, or a specific day.",
          "said": null
        },
        {
          "role": "caller",
          "text": "Next week works for me. Whatever weekday morning you have open is fine, so if you have something on Monday, that would be great.",
          "said": null
        },
        {
          "role": "agent",
          "text": "Okay, one moment. Monday I have 12 to 12:30 or 12:30 to 1.",
          "said": null
        },
        {
          "role": "caller",
          "text": "The 12 to 12:30 window works for me. Just so the tech knows, I work from home, so I'll be around, and they can ring the downstairs bell when they arrive.",
          "said": null
        },
        {
          "role": "agent",
          "text": "Okay, thanks. Will you be able to approve any repair work the technician recommends?",
          "said": null
        },
        {
          "role": "caller",
          "text": "I can, as long as they explain what needs fixing and what it costs before doing the work. Please have them call me first if anything beyond the tune-up comes up.",
          "said": null
        },
        {
          "role": "agent",
          "text": "Just a moment. And is there a gate code or buzzer the technician should know about?",
          "said": null
        },
        {
          "role": "caller",
          "text": "No gate code. Just ring the downstairs bell. It's the unit on the ground floor, and I'll come down to let them in.",
          "said": null
        },
        {
          "role": "agent",
          "text": "Okay, I've booked it: the technician will arrive Monday, November 9, between 12 and 12:30. Anything else?",
          "said": null
        },
        {
          "role": "caller",
          "text": "That's perfect, thanks, Brian. Have a good day.",
          "said": null
        },
        {
          "role": "agent",
          "text": "You too. Thanks for calling Summit Air. Have a great afternoon!",
          "said": null
        }
