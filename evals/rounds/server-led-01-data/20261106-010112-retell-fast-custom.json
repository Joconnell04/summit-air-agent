      "transcript": [
        {
          "role": "agent",
          "text": "Hi there, thanks so much for calling Summit Air today! I'm Brooke, the virtual assistant. How can I help?",
          "said": null
        },
        {
          "role": "caller",
          "text": "Hi, my furnace stopped heating last night and the house is getting cold.",
          "said": null
        },
        {
          "role": "agent",
          "text": "Sorry to hear that. Can I get your name?",
          "said": null
        },
        {
          "role": "caller",
          "text": "Sure, it's Alicia Romero.",
          "said": null
        },
        {
          "role": "agent",
          "text": "Thanks.\n\nAnd this is for a residential property, right? Like a home or an apartment?",
          "said": null
        },
        {
          "role": "caller",
          "text": "Yes, it's a house. It's a residential home in Marine Park.",
          "said": null
        },
        {
          "role": "agent",
          "text": "Got it, and what's the street address, including the house number?",
          "said": null
        },
        {
          "role": "caller",
          "text": "It's 2214 Avenue U, Brooklyn, 11229.",
          "said": null
        },
        {
          "role": "agent",
          "text": "Thanks, I have 2214 Avenue U, Brooklyn, 11229. Is there an apartment or unit number, or is it a standalone house?",
          "said": null
        },
        {
          "role": "caller",
          "text": "It's a standalone house, so there's no apartment or unit number.",
          "said": null
        },
        {
          "role": "agent",
          "text": "No problem. Is the heat completely out, or is it just not keeping up?",
          "said": null
        },
        {
          "role": "caller",
          "text": "It's completely out. The furnace isn't producing any heat at all, and the thermostat reads 62 degrees.",
          "said": null
        },
        {
          "role": "agent",
          "text": "Thanks for that. Since when has it been completely out?",
          "said": null
        },
        {
          "role": "caller",
          "text": "Since last night. It was working fine during the day, and then it just stopped.",
          "said": null
        },
        {
          "role": "agent",
          "text": "What's the best phone number to reach you?",
          "said": null
        },
        {
          "role": "caller",
          "text": "The best number is the one I'm calling from, (332) 555-0121.",
          "said": null
        },
        {
          "role": "agent",
          "text": "So that's 2214 Avenue U, and the number you're calling from, ending in 0121. That's all correct, right?",
          "said": null
        },
        {
          "role": "caller",
          "text": "Yes, that's all correct.",
          "said": null
        },
        {
          "role": "agent",
          "text": "The soonest opening is tomorrow, Friday, November 6, from 8 to 8:30 AM. Does that work for you?",
          "said": null
        },
        {
          "role": "caller",
          "text": "Yes, tomorrow morning works. I'll take the 8 to 8:30 AM window.",
          "said": null
        },
        {
          "role": "agent",
          "text": "Will you be able to approve any repair work the technician recommends?",
          "said": null
        },
        {
          "role": "caller",
          "text": "Yes, I can approve repairs when the technician comes out. Just let me know what it will cost before any work starts.",
          "said": null
        },
        {
          "role": "agent",
          "text": "Will someone be home to let the technician in?",
          "said": null
        },
        {
          "role": "caller",
          "text": "Yes, someone will be home all day. It's two healthy adults, and there are no pets.",
          "said": null
        },
        {
          "role": "agent",
          "text": "Is there a gate code, a buzzer, or anything else the technician should know to get in?",
          "said": null
        },
        {
          "role": "caller",
          "text": "No gate code or buzzer. It's a standalone house, so the technician can just come to the front door. I've already tried changing the thermostat batteries, but nothing else.",
          "said": null
        },
        {
          "role": "agent",
          "text": "Okay, you're booked. The technician will arrive tomorrow, Friday, November 6, between 8 and 8:30 AM. Anything else?",
          "said": null
        },
        {
          "role": "caller",
          "text": "No, that's everything. Thank you so much for your help. Goodbye.",
          "said": null
        },
        {
          "role": "agent",
          "text": "Thanks so much for calling Summit Air today. Have a great day! The soonest I have is tomorrow, 8 to 8:30. Does that work? If anything makes this more urgent for you, just let me know.",
          "said": null
        },
        {
          "role": "caller",
          "text": "Yes, I already booked that window for tomorrow, 8 to 8:30 AM. Nothing makes it more urgent beyond the house being cold, so that's all I need. Thanks, goodbye.",
          "said": null
        },
        {
          "role": "agent",
          "text": "Take care.",
          "said": null
        }
