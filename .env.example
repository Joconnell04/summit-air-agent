# Copy to .env and fill in. .env is gitignored; never commit real values.

# Brain (one per provider in config/models.yaml; Anthropic is the default)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MODEL_PROFILE=fast

# Ears and mouth
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# Switchboard and phone
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# The owner view's first admin (app/accounts.py), created once at startup if no user has this
# username; more users from the Settings page or make owner-user. OWNER_TOKEN and RULES_EDITORS
# are no longer read. A real password only in the server's .env, never here.
OWNER_ADMIN_USERNAME=
OWNER_ADMIN_NAME=
OWNER_ADMIN_PASSWORD=

# Warm transfer (app/transfer.py). Unset keeps the flag and named callback. Real numbers only in
# the server's .env, never here.
TRANSFER_OFFICE_NUMBER=
TRANSFER_ON_CALL_NUMBER=

# Call recordings (app/recordings.py): the S3-compatible bucket LiveKit uploads to. Unset, nothing
# is recorded. RECORDINGS_DIR defaults to data/recordings beside the database.
RECORDING_S3_BUCKET=
RECORDING_S3_ENDPOINT=
RECORDING_S3_REGION=
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET=

# Retell baseline (decision 004)
RETELL_API_KEY=

# Audio bake-off entrant (decision 026)
ELEVENLABS_API_KEY=

# Tooling
POSTMAN_API_KEY=
JEV_API_KEY=

# Eval results viewer (optional)
LANGSMITH_API_KEY=

# Numbers a heads-up call may dial after a change from another number (app/heads_up.py),
# comma-separated. Empty dials none; every other heads-up is recorded as would-have-called.
HEADSUP_ALLOWLIST=
