  {
   "args_at_root": false,
   "description": "Availability for a job type. Without `day` it returns the shape of availability over the coming days; with `day` it returns that day's exact arrival windows. Pass what you've heard that bears on priority in `facts`.",
   "max_retry": 1,
   "method": "POST",
   "name": "find_slots",
   "parameters": {
    "additionalProperties": false,
    "properties": {
     "day": {
      "anyOf": [
       {
        "format": "date",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Ask for one day's exact windows"
     },
     "facts": {
      "additionalProperties": false,
      "description": "What the agent has heard that bears on priority. The server also reads every caller line.",
      "properties": {
       "inside_temp_f": {
        "anyOf": [
         {
          "maximum": 130,
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "issue": {
        "maxLength": 300,
        "type": "string"
       },
       "temp_falling_fast": {
        "type": "boolean"
       },
       "who_home": {
        "maxLength": 300,
        "type": "string"
       }
      },
      "type": "object"
     },
     "job_type": {
      "enum": [
       "no_heat",
       "no_cooling",
       "tune_up",
       "safety_check",
       "estimate"
      ],
      "maxLength": 40,
      "type": "string"
     },
     "preferred_days": {
      "items": {
       "type": "string"
      },
      "maxItems": 7,
      "type": "array"
     },
     "priority": {
      "anyOf": [
       {
        "enum": [
         "Low",
         "Normal",
         "High",
         "Urgent"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "The agent's view; logged, not used"
     },
     "time_of_day": {
      "anyOf": [
       {
        "enum": [
         "morning",
         "afternoon",
         "evening"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "job_type"
    ],
    "type": "object"
   },
   "speak_after_execution": true,
   "speak_during_execution": false,
   "timeout_ms": 10000,
   "type": "custom",
   "url": "https://45-77-105-247.sslip.io/retell/tools/find_slots"
  },
