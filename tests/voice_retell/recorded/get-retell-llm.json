  {
   "args_at_root": false,
   "description": "Look up a customer by a phone number or an address the caller gave. Returns only records that match, with membership, open jobs, last service date, recent calls and notes. The number the call came from was already looked up before hello.",
   "max_retry": 1,
   "method": "POST",
   "name": "find_customer",
   "parameters": {
    "additionalProperties": false,
    "properties": {
     "address": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "city": {
          "default": "",
          "maxLength": 60,
          "type": "string"
         },
         "street": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
         },
         "unit": {
          "default": "",
          "maxLength": 20,
          "type": "string"
         },
         "zip": {
          "pattern": "^\\d{5}$",
          "type": "string"
         }
        },
        "required": [
         "street",
         "zip"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "phone": {
      "anyOf": [
       {
        "maxLength": 40,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "type": "object"
   },
   "speak_after_execution": true,
   "speak_during_execution": false,
   "timeout_ms": 10000,
   "type": "custom",
   "url": "https://45-77-105-247.sslip.io/retell/tools/find_customer"
  },
